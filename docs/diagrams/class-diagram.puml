@startuml
title TunSociety - Class Diagram

top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide circle

package "Angular Frontend" {
  class ApiService {
    -baseUrl : string
    +get()
    +post()
    +put()
    +delete()
  }

  class AuthService {
    -tokenKey : string
    -userKey : string
    +register()
    +login()
    +logout()
    +syncCurrentUser()
  }

  class UserService {
    +getById()
    +update()
    +uploadAvatar()
    +search()
  }

  class CommunityService {
    +getPosts()
    +createPost()
    +updatePost()
    +addComment()
    +reactToPost()
    +sendDirectMessage()
  }

  class "ModerationService\n(Angular)" as NgModerationService {
    +score()
    +getFlaggedContent()
    +getWarnings()
    +getFreezes()
    +getAppeals()
    +updateAppealStatus()
  }

  class AdminService {
    +getOverview()
    +getStatisticsOverview()
    +getUsers()
    +getActivityFeed()
    +issueWarning()
    +freezeUser()
    +reviewModerationResult()
  }
}

package "ASP.NET Core API" {
  class AuthController {
    +Register()
    +Login()
  }

  class UsersController {
    +Search()
    +GetCurrent()
    +GetById()
    +Update()
    +UploadAvatar()
  }

  class PostsController {
    +GetFeed()
    +Create()
    +Update()
    +Delete()
    +AddComment()
    +React()
  }

  class FriendRequestsController {
    +GetByUser()
    +Create()
    +UpdateStatus()
    +Cancel()
  }

  class DirectMessagesController {
    +GetConversations()
    +Send()
    +UpdateConversationReadCursor()
    +MarkConversationRead()
  }

  class NotificationsController {
    +GetByUser()
    +Create()
    +MarkRead()
    +MarkAllRead()
  }

  class ModerationController {
    +Score()
    +Moderate()
    +GetFlaggedContent()
    +GetWarnings()
    +GetFreezes()
    +GetAppeals()
    +UpdateAppealStatus()
  }

  class AdminController {
    +GetOverview()
    +GetStatisticsOverview()
    +GetUsers()
    +GetUserRiskSummary()
    +IssueWarning()
    +FreezeUser()
    +UnfreezeUser()
    +ReviewModerationResult()
  }
}

package "Application Services" {
  class "ModerationService\n(.NET)" as DotNetModerationService {
    +EvaluateAsync()
    +DetermineAction()
    +BuildReason()
  }

  class AiScoringClient {
    -cache : MemoryCache
    +AnalyzeAsync()
    +ScoreAsync()
    +ComputeSimilarity()
  }

  class LocalAiService {
    -baseUrl : string
    -model : string
    +ModerateAsync()
    +BuildPrompt()
    +ParseResponse()
  }

  class SanctionService {
    -freezeThreshold : int
    +EvaluateAsync()
    +BuildWarningReason()
  }

  class AuditService {
    +LogAsync()
    +GetRecentActivityAsync()
    +GetActivityFeedAsync()
  }

  class JwtTokenService {
    +CreateToken()
  }

  class AvatarStorageService {
    +SaveAvatarAsync()
    +OpenAvatarReadStream()
    +DeleteManagedAvatar()
  }
}

package "Persistence" {
  class ApplicationDbContext {
    +Users : DbSet<User>
    +Posts : DbSet<Post>
    +DirectMessages : DbSet<DirectMessage>
    +ModerationResults : DbSet<ModerationResult>
    +Warnings : DbSet<Warning>
    +Freezes : DbSet<Freeze>
    +Appeals : DbSet<Appeal>
    +AuditLogs : DbSet<AuditLog>
    +SaveChangesAsync()
  }
}

package "Domain Entities" {
  class User {
    +Id : Guid
    +UserName : string
    +Email : string
    +DisplayName : string
    +Role : string
    +IsFrozen : bool
    +CreatedAtUtc : DateTime
  }

  class Post {
    +Id : Guid
    +UserId : Guid
    +Title : string
    +Content : string
    +Visibility : string
    +CreatedAtUtc : DateTime
  }

  class PostComment {
    +Id : Guid
    +PostId : Guid
    +UserId : Guid
    +Content : string
    +CreatedAtUtc : DateTime
  }

  class PostReaction {
    +Id : Guid
    +PostId : Guid
    +UserId : Guid
    +ReactionType : string
    +CreatedAtUtc : DateTime
  }

  class FriendRequest {
    +Id : Guid
    +RequesterUserId : Guid
    +RecipientUserId : Guid
    +Status : string
    +Note : string?
    +CreatedAtUtc : DateTime
  }

  class DirectMessage {
    +Id : Guid
    +SenderUserId : Guid
    +RecipientUserId : Guid
    +Content : string
    +IsRead : bool
    +CreatedAtUtc : DateTime
  }

  class DirectMessageReadCursor {
    +UserId : Guid
    +PartnerUserId : Guid
    +LastVisibleMessageId : Guid?
    +UpdatedAtUtc : DateTime
  }

  class CommunityNotification {
    +Id : Guid
    +UserId : Guid
    +Type : string
    +Title : string
    +IsRead : bool
    +CreatedAtUtc : DateTime
  }

  class Message {
    +Id : Guid
    +UserId : Guid
    +Content : string
    +Score : double
    +Status : string
    +CreatedAtUtc : DateTime
  }

  class ModerationResult {
    +Id : Guid
    +ContentId : Guid
    +ContentType : string
    +UserId : Guid
    +Score : double
    +Action : string
    +FlagsData : string
    +CreatedAtUtc : DateTime
    +Flags()
  }

  class Warning {
    +Id : Guid
    +UserId : Guid
    +Reason : string
    +IssuedAtUtc : DateTime
  }

  class Freeze {
    +Id : Guid
    +UserId : Guid
    +Reason : string
    +StartsAtUtc : DateTime
    +EndsAtUtc : DateTime?
    +IsActive : bool
  }

  class Appeal {
    +Id : Guid
    +UserId : Guid
    +TargetType : string
    +TargetId : Guid
    +Status : string
    +Reason : string?
    +ResolvedAtUtc : DateTime?
  }

  class AuditLog {
    +Id : Guid
    +ActorUserId : Guid?
    +SubjectUserId : Guid?
    +Category : string
    +Action : string
    +EntityType : string
    +CreatedAtUtc : DateTime
  }
}

package "External AI" {
  class "Ollama Local API" as OllamaApi <<external>> {
    +Generate()
  }
}

AuthService "1" -- "1" ApiService : uses
UserService "1" -- "1" ApiService : uses
CommunityService "1" -- "1" ApiService : uses
NgModerationService "1" -- "1" ApiService : uses
AdminService "1" -- "1" ApiService : uses

ApiService "1" -- "1" AuthController : auth API
ApiService "1" -- "1" UsersController : user API
ApiService "1" -- "1" PostsController : posts API
ApiService "1" -- "1" FriendRequestsController : requests API
ApiService "1" -- "1" DirectMessagesController : messaging API
ApiService "1" -- "1" NotificationsController : notifications API
ApiService "1" -- "1" ModerationController : moderation API
ApiService "1" -- "1" AdminController : admin API

AuthController "1" -- "1" JwtTokenService : creates tokens
AuthController "1" -- "1" DotNetModerationService : moderates names
UsersController "1" -- "1" AvatarStorageService : stores avatars
UsersController "1" -- "1" DotNetModerationService : moderates profile
UsersController "1" -- "1" SanctionService : applies sanctions
PostsController "1" -- "1" DotNetModerationService : moderates posts
PostsController "1" -- "1" SanctionService : applies sanctions
FriendRequestsController "1" -- "1" DotNetModerationService : moderates notes
FriendRequestsController "1" -- "1" SanctionService : applies sanctions
DirectMessagesController "1" -- "1" DotNetModerationService : moderates messages
DirectMessagesController "1" -- "1" SanctionService : applies sanctions
ModerationController "1" -- "1" LocalAiService : direct AI test
ModerationController "1" -- "1" DotNetModerationService : scores content
AdminController "1" -- "1" AuditService : reads activity

AuthController "1" -- "1" ApplicationDbContext : uses
UsersController "1" -- "1" ApplicationDbContext : uses
PostsController "1" -- "1" ApplicationDbContext : uses
FriendRequestsController "1" -- "1" ApplicationDbContext : uses
DirectMessagesController "1" -- "1" ApplicationDbContext : uses
NotificationsController "1" -- "1" ApplicationDbContext : uses
ModerationController "1" -- "1" ApplicationDbContext : uses
AdminController "1" -- "1" ApplicationDbContext : uses

DotNetModerationService "1" -- "1" AiScoringClient : analyzes with
AiScoringClient "1" -- "1" LocalAiService : asks
LocalAiService "1" -- "1" OllamaApi : calls
SanctionService "1" -- "0..*" Warning : creates
SanctionService "1" -- "0..*" Freeze : creates
AuditService "1" -- "0..*" AuditLog : writes
AvatarStorageService "1" -- "0..*" User : updates avatar

User "1" -- "0..*" Post : creates
User "1" -- "0..*" PostComment : writes
Post "1" -- "0..*" PostComment : contains
User "1" -- "0..*" PostReaction : reacts
Post "1" -- "0..*" PostReaction : receives
User "1" -- "0..*" Message : submits
User "1" -- "0..*" CommunityNotification : receives
User "1" -- "0..*" ModerationResult : owns
User "1" -- "0..*" Warning : receives
User "1" -- "0..*" Freeze : has
User "1" -- "0..*" Appeal : submits
User "0..1" -- "0..*" AuditLog : actor
User "0..1" -- "0..*" AuditLog : subject
User "1" -- "0..*" DirectMessage : sender
User "1" -- "0..*" DirectMessage : recipient
User "1" -- "0..*" DirectMessageReadCursor : tracks
User "1" -- "0..*" DirectMessageReadCursor : partner
User "1" -- "0..*" FriendRequest : requester
User "1" -- "0..*" FriendRequest : recipient

@enduml
